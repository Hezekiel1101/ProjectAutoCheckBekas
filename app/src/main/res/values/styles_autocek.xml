<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Ikon toolbar (back, titik tiga) jadi putih di atas header gradient -->
    <style name="ThemeOverlay.AutoCek.Toolbar" parent="">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <!-- Kartu: sudut bulat, garis tipis, tanpa bayangan -->
    <style name="Widget.AutoCek.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Input field sudut lebih bulat -->
    <style name="Widget.AutoCek.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
</resources>